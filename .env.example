# ==============================================================================
# TestPulse Root Environment Example
# Copy to .env for local development (git-ignored).
# Full documentation: docs/ops/environment.md
# ==============================================================================

# Core Application Settings
NODE_ENV=development
DEPLOYMENT_PROFILE=free
PORT=4000
LOG_LEVEL=info
RUN_WORKERS_IN_PROCESS=true
TRUST_PROXY=false

# Origins & Routing
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connections (Neon PostgreSQL / Local Postgres)
# Runtime pooled URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/testpulse
# Direct URL used for Prisma migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/testpulse
# Test isolation database URL
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/testpulse_test

# Redis Connection (BullMQ & Socket.IO Redis Adapter/Emitter)
# Optional locally (ioredis-mock used in unit tests); required for test:contract and background workers
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets (minimum 32 bytes)
# JWT_ACCESS_SECRET=your-32-byte-random-jwt-access-secret-placeholder
# JWT_REFRESH_SECRET=your-32-byte-random-jwt-refresh-secret-placeholder
# WEBHOOK_SECRET_ENCRYPTION_KEY=your-32-byte-base64-encryption-key
# UNSUBSCRIBE_SIGNING_SECRET=your-hmac-unsubscribe-signing-secret

# Observability (Sentry)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=local
# GIT_COMMIT_SHA=dev-local

# Staging CI/CD Deployment Secrets (GitHub Secrets)
# STAGING_DIRECT_URL=postgresql://...
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...
