# apps/api local environment — copy to .env (git-ignored). Full catalog: docs/ops/environment.md
NODE_ENV=development
DEPLOYMENT_PROFILE=free
PORT=4000
LOG_LEVEL=info
RUN_WORKERS_IN_PROCESS=true
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Local PostgreSQL from `npm run db:start` (docs/database/local-setup.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/testpulse
# Optional locally: without it, background workers are disabled
# REDIS_URL=redis://localhost:6379
