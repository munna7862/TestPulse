{
  "name": "@testpulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "@testpulse/db": "*",
    "@testpulse/shared": "*",
    "bullmq": "^6.3.11",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^24.0.0",
    "ioredis-mock": "^8.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
