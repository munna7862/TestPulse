// TestPulse schema. Canonical entity list: planning/master/TestPulse_Master_Plan.md §5;
// constraints and isolation classes: docs/database/schema.md.
// P02-S03 creates skeletons of the identity/tenancy tables so the tenant-scoped client and the test
// harness can be built and tested. Phase 03 extends these models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

/// Global (identity) table — accessed via systemDb in auth modules only.
model User {
  id                 String              @id @default(uuid(7))
  email              String              @unique
  emailVerifiedAt    DateTime?
  passwordHash       String?
  name               String
  avatarUrl          String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        OrgMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]
  sentInvitations    Invitation[]        @relation("InvitedBy")
  createdApiKeys     ApiKey[]            @relation("CreatedApiKeys")
}

/// Global (identity) table — OAuth accounts linked to users.
model OAuthAccount {
  id                String        @id @default(uuid(7))
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Global (identity) table — refresh-token session families (ADR-005).
model Session {
  id               String    @id @default(uuid(7))
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

/// Global (identity) table — single-use tokens for email verification and password reset.
model VerificationToken {
  id        String                @id @default(uuid(7))
  userId    String
  type      VerificationTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

/// Tenant boundary.
model Organization {
  id          String       @id @default(uuid(7))
  name        String
  slug        String       @unique
  planTier    PlanTier     @default(FREE)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     OrgMember[]
  invitations Invitation[]
  projects    Project[]
  apiKeys     ApiKey[]
}

/// Org-scoped. Single-use team invitation bound to normalized lowercase email with 7-day expiry.
model Invitation {
  id          String       @id @default(uuid(7))
  orgId       String
  email       String
  role        OrgRole
  tokenHash   String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@index([orgId, acceptedAt, revokedAt, expiresAt])
}

/// Org-scoped.
model OrgMember {
  id        String       @id @default(uuid(7))
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Org-scoped. Settings defaults: master plan §5; retentionDays 30 (effective = min(project, plan max), §8).
model Project {
  id              String       @id @default(uuid(7))
  orgId           String
  name            String
  slug            String
  description     String?
  defaultBranch   String       @default("main")
  /// Incremented atomically per run (P04).
  runCounter      Int          @default(0)
  slaDays         Int          @default(14)
  retentionDays   Int          @default(30)
  flakyWindow     Int          @default(10)
  flakyThreshold  Int          @default(3)
  trackedBranches String[]     @default(["main"])
  /// Soft delete; the purge job (S-003) removes the row and its data.
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys         ApiKey[]

  @@unique([orgId, slug])
  @@index([orgId])
}

/// Project-scoped CI API key (master plan §5, security model §2.5). Plaintext is never stored; SHA-256 hash only.
model ApiKey {
  id          String       @id @default(uuid(7))
  orgId       String
  projectId   String
  name        String
  prefix      String
  keyHash     String       @unique
  createdById String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, revokedAt])
  @@index([orgId])
}
