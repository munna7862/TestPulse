// TestPulse schema. Canonical entity list: planning/master/TestPulse_Master_Plan.md §5;
// constraints and isolation classes: docs/database/schema.md.
// P02-S03 creates skeletons of the identity/tenancy tables so the tenant-scoped client and the test
// harness can be built and tested. Phase 03 extends these models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

/// Global (identity) table — accessed via systemDb in auth modules only.
model User {
  id                 String              @id @default(uuid(7))
  email              String              @unique
  emailVerifiedAt    DateTime?
  passwordHash       String?
  name               String
  avatarUrl          String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        OrgMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  oauthAccounts      OAuthAccount[]
}

/// Global (identity) table — OAuth accounts linked to users.
model OAuthAccount {
  id                String        @id @default(uuid(7))
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Global (identity) table — refresh-token session families (ADR-005).
model Session {
  id               String    @id @default(uuid(7))
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

/// Global (identity) table — single-use tokens for email verification and password reset.
model VerificationToken {
  id        String                @id @default(uuid(7))
  userId    String
  type      VerificationTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
}

/// Tenant boundary.
model Organization {
  id        String      @id @default(uuid(7))
  name      String
  slug      String      @unique
  planTier  PlanTier    @default(FREE)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   OrgMember[]
  projects  Project[]
}

/// Org-scoped.
model OrgMember {
  id        String       @id @default(uuid(7))
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Org-scoped. Settings columns are added in P03-S03.
model Project {
  id        String       @id @default(uuid(7))
  orgId     String
  name      String
  slug      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
}
