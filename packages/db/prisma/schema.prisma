// TestPulse schema. Canonical entity list: planning/master/TestPulse_Master_Plan.md §5;
// constraints and isolation classes: docs/database/schema.md.
// P02-S03 creates skeletons of the identity/tenancy tables so the tenant-scoped client and the test
// harness can be built and tested. Phase 03 extends these models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Global (identity) table — accessed via systemDb in auth modules only.
model User {
  id              String      @id @default(uuid(7))
  email           String      @unique
  emailVerifiedAt DateTime?
  name            String
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  memberships     OrgMember[]
}

/// Tenant boundary.
model Organization {
  id        String      @id @default(uuid(7))
  name      String
  slug      String      @unique
  planTier  PlanTier    @default(FREE)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   OrgMember[]
  projects  Project[]
}

/// Org-scoped.
model OrgMember {
  id        String       @id @default(uuid(7))
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// Org-scoped. Settings columns are added in P03-S03.
model Project {
  id        String       @id @default(uuid(7))
  orgId     String
  name      String
  slug      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, slug])
  @@index([orgId])
}
